{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Auralis Paper",
  "author": "Auralis Labs community port fixture",
  "themes": [
    {
      "name": "Auralis Paper",
      "appearance": "light",
      "style": {
        "background": "#faf4ec",
        "foreground": "#352c25",
        "text": "#352c25",
        "text.muted": "#7e6d56",
        "accent": "#d45b3d",
        "border": "#cbc3b8",
        "editor.background": "#faf4ec",
        "editor.foreground": "#352c25",
        "editor.active_line.background": "#f2eae0",
        "panel.background": "#f3ede6",
        "status_bar.background": "#ede7de",
        "title_bar.background": "#f1eae1",
        "success": "#308639",
        "warning": "#bb6a00",
        "error": "#cc272e",
        "modified": "#bb6a00",
        "created": "#308639",
        "deleted": "#cc272e",
        "terminal.background": "#ede7de",
        "terminal.foreground": "#352c25",
        "terminal.ansi.background": "#ede7de",
        "terminal.ansi.black": "#282019",
        "terminal.ansi.red": "#cc272e",
        "terminal.ansi.green": "#308639",
        "terminal.ansi.yellow": "#bb6a00",
        "terminal.ansi.blue": "#044cb6",
        "terminal.ansi.magenta": "#6365c1",
        "terminal.ansi.cyan": "#007982",
        "terminal.ansi.white": "#352c25",
        "terminal.ansi.bright_black": "#80756d",
        "terminal.ansi.bright_red": "#be000c",
        "terminal.ansi.bright_green": "#007617",
        "terminal.ansi.bright_yellow": "#ad5300",
        "terminal.ansi.bright_blue": "#0035ad",
        "terminal.ansi.bright_magenta": "#524fb8",
        "terminal.ansi.bright_cyan": "#006975",
        "terminal.ansi.bright_white": "#2b221b",
        "syntax": {
          "comment": {
            "color": "#7e6d56"
          },
          "string": {
            "color": "#1e7729"
          },
          "number": {
            "color": "#b25400"
          },
          "keyword": {
            "color": "#ad215f"
          },
          "function": {
            "color": "#044cb6"
          },
          "type": {
            "color": "#007982"
          },
          "property": {
            "color": "#6d3800"
          },
          "operator": {
            "color": "#a43c2f"
          },
          "punctuation": {
            "color": "#756b63"
          }
        }
      }
    }
  ]
}
