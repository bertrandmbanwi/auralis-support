{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Auralis Noir High Contrast",
  "author": "Auralis Labs community port fixture",
  "themes": [
    {
      "name": "Auralis Noir High Contrast",
      "appearance": "dark",
      "style": {
        "background": "#040508",
        "foreground": "#faf6ef",
        "text": "#faf6ef",
        "text.muted": "#101219",
        "accent": "#ff9550",
        "border": "#494d57",
        "editor.background": "#040508",
        "editor.foreground": "#faf6ef",
        "editor.active_line.background": "#101219",
        "panel.background": "#030306",
        "status_bar.background": "#020305",
        "title_bar.background": "#0b0d13",
        "success": "#6ec272",
        "warning": "#e9ab2b",
        "error": "#fc5855",
        "modified": "#e9ab2b",
        "created": "#6ec272",
        "deleted": "#fc5855",
        "terminal.background": "#020305",
        "terminal.foreground": "#faf6ef",
        "terminal.ansi.background": "#020305",
        "terminal.ansi.black": "#040508",
        "terminal.ansi.red": "#fc5855",
        "terminal.ansi.green": "#6ec272",
        "terminal.ansi.yellow": "#e9ab2b",
        "terminal.ansi.blue": "#25d2fc",
        "terminal.ansi.magenta": "#e175d9",
        "terminal.ansi.cyan": "#52dfbf",
        "terminal.ansi.white": "#faf6ef",
        "terminal.ansi.bright_black": "#8e929e",
        "terminal.ansi.bright_red": "#ff625f",
        "terminal.ansi.bright_green": "#75d87a",
        "terminal.ansi.bright_yellow": "#ffbc19",
        "terminal.ansi.bright_blue": "#00e8ff",
        "terminal.ansi.bright_magenta": "#fc82f3",
        "terminal.ansi.bright_cyan": "#47f7d2",
        "terminal.ansi.bright_white": "#fcf8f1",
        "syntax": {
          "comment": {
            "color": "#8791af"
          },
          "string": {
            "color": "#e1c34b"
          },
          "number": {
            "color": "#ff9381"
          },
          "keyword": {
            "color": "#f47db9"
          },
          "function": {
            "color": "#25d2fc"
          },
          "type": {
            "color": "#52dfbf"
          },
          "property": {
            "color": "#e6bd77"
          },
          "operator": {
            "color": "#ce84a7"
          },
          "punctuation": {
            "color": "#b7bdce"
          }
        }
      }
    }
  ]
}
